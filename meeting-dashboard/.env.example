# Server-only settings. Copy to .env.local for local development; never commit real keys.
CAL_ACCOUNT_EMAIL=hello@truemarch.fun
CAL_API_KEY=
# Keep the existing secret when updating this installation (at least 32 characters).
CAL_SESSION_SECRET=
# Optional: comma-separated IDs of public meeting types to offer. Empty offers all eligible types.
CAL_EVENT_TYPE_IDS=
